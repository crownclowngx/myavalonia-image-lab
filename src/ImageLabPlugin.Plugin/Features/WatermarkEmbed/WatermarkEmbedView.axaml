<UserControl
    x:Class="ImageLabPlugin.Features.WatermarkEmbed.WatermarkEmbedView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ImageLabPlugin.Features.WatermarkEmbed"
    x:DataType="vm:WatermarkEmbedDocument">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <Button Command="{Binding SelectSourceCommand}" Content="选择源图" />
      <TextBox Grid.Column="1" Text="{Binding SourcePath}" PlaceholderText="PNG/JPEG 路径" />
      <ComboBox Grid.Column="2" Width="90" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}" />
      <Button Grid.Column="3" Command="{Binding EstimateCapacityCommand}" Content="估算容量" />
      <Button Grid.Column="4" Command="{Binding EmbedCommand}" Content="写入并自检" />
      <Button Grid.Column="5" Command="{Binding SaveOutputCommand}" Content="保存输出" IsEnabled="{Binding HasOutput}" />
      <Button Grid.Column="6" Command="{Binding CancelCommand}" Content="取消" IsEnabled="{Binding IsBusy}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12">
      <Grid RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8">
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
          <Grid>
            <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
            <TextBlock Margin="6" VerticalAlignment="Top" Text="原图" />
          </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
          <Grid>
            <Image Source="{Binding OutputPreview}" Stretch="Uniform" />
            <TextBlock Margin="6" VerticalAlignment="Top" Text="输出" />
          </Grid>
        </Border>
        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
          <Grid>
            <Image Source="{Binding DifferencePreview}" Stretch="Uniform" />
            <TextBlock Margin="6" VerticalAlignment="Top" Text="差异 ×4" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
          <Grid>
            <Image Source="{Binding SpectrumPreview}" Stretch="Uniform" />
            <TextBlock Margin="6" VerticalAlignment="Top" Text="DCT 对数幅度" />
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="Payload 与安全" />
          <CheckBox Content="从文件读取 Payload" IsChecked="{Binding UsePayloadFile}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding UsePayloadFile}">
            <TextBox Text="{Binding PayloadFilePath}" PlaceholderText="Payload 文件路径" />
            <Button Grid.Column="1" Command="{Binding SelectPayloadFileCommand}" Content="选择文件" />
          </Grid>
          <TextBox AcceptsReturn="True" Height="160" Text="{Binding PayloadText}" TextWrapping="Wrap" PlaceholderText="输入文本或 JSON" IsVisible="{Binding !UsePayloadFile}" />
          <CheckBox Content="把文本作为 JSON 校验" IsChecked="{Binding TreatTextAsJson}" IsVisible="{Binding !UsePayloadFile}" />
          <CheckBox Content="使用密码保护（PBKDF2 + AES-256-GCM）" IsChecked="{Binding UseEncryption}" />
          <TextBox PasswordChar="●" Text="{Binding Password}" PlaceholderText="密码不会写入 Document 快照" IsVisible="{Binding UseEncryption}" />
          <CheckBox Content="输出 JPEG（PNG 更稳定）" IsChecked="{Binding OutputJpeg}" />
          <NumericUpDown Minimum="1" Maximum="100" Value="{Binding JpegQuality}" IsVisible="{Binding OutputJpeg}" />
          <TextBlock FontWeight="SemiBold" Text="{Binding CapacitySummary}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" Padding="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
