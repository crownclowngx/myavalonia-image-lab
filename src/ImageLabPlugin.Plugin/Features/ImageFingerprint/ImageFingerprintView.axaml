<UserControl
    x:Class="ImageLabPlugin.Features.ImageFingerprint.ImageFingerprintView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ImageLabPlugin.Features.ImageFingerprint"
    x:DataType="vm:ImageFingerprintDocument">
  <UserControl.Styles>
    <StyleInclude Source="/Styles/ImageLabDocumentStyles.axaml" />
  </UserControl.Styles>
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
      <Button Command="{Binding SelectReferenceCommand}" Content="选择参考图" AutomationProperties.Name="选择感知指纹参考图" />
      <TextBox Grid.Column="1" Text="{Binding ReferencePath}" PlaceholderText="参考图 PNG/JPEG 路径" />
      <Button Grid.Column="2" Command="{Binding SelectCandidateCommand}" Content="选择候选图" AutomationProperties.Name="选择感知指纹候选图" />
      <TextBox Grid.Column="3" Text="{Binding CandidatePath}" PlaceholderText="候选图 PNG/JPEG 路径" />
      <Button Grid.Column="4" Command="{Binding SwapCommand}" Content="交换 A/B" />
      <Button Grid.Column="5" Command="{Binding ComputeCommand}" Content="计算指纹" />
      <Button Grid.Column="6" Command="{Binding CancelCommand}" Content="取消" IsEnabled="{Binding IsOperationBusy}" />
      <Button Grid.Column="7" Command="{Binding CopySummaryCommand}" Content="复制摘要" IsEnabled="{Binding HasResult}" />
      <Button Grid.Column="8" Command="{Binding ExportReportCommand}" Content="导出 JSON" IsEnabled="{Binding HasResult}" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
      <CheckBox Content="显示预览" IsChecked="{Binding ShowPreviews}" />
      <CheckBox Content="显示 8×8 位图" IsChecked="{Binding ShowFingerprintBitmaps}" />
      <CheckBox Content="显示限制" IsChecked="{Binding ShowLimitations}" />
      <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding Overview}" />
      <TextBlock VerticalAlignment="Center" Text="位相似度不是来源概率" Opacity="0.8" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding ShowPreviews}">
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
            <StackPanel><TextBlock Text="参考图 A" FontWeight="SemiBold" /><Image Height="210" Stretch="Uniform" Source="{Binding ReferencePreview}" /></StackPanel>
          </Border>
          <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
            <StackPanel><TextBlock Text="候选图 B" FontWeight="SemiBold" /><Image Height="210" Stretch="Uniform" Source="{Binding CandidatePreview}" /></StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="{Binding ImageFacts}" TextWrapping="Wrap" />

        <ListBox ItemsSource="{Binding AlgorithmRows}" SelectedItem="{Binding SelectedAlgorithm}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FingerprintAlgorithmRow">
              <Grid ColumnDefinitions="70,220,220,80,100,170" ColumnSpacing="8" Margin="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ReferenceHex}" FontFamily="Consolas" />
                <TextBlock Grid.Column="2" Text="{Binding CandidateHex}" FontFamily="Consolas" />
                <TextBlock Grid.Column="3" Text="{Binding Distance}" />
                <TextBlock Grid.Column="4" Text="{Binding Similarity}" />
                <TextBlock Grid.Column="5" Text="{Binding Decision}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding SelectedAlgorithmDetails}" TextWrapping="Wrap" IsVisible="{Binding ShowLimitations}" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding ShowFingerprintBitmaps}">
          <StackPanel><TextBlock Text="A 位图" HorizontalAlignment="Center" /><vm:FingerprintBitmapControl Width="200" Height="200" Bits="{Binding ReferenceBits}" AutomationProperties.Name="参考图 8×8 指纹位图" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="B 位图" HorizontalAlignment="Center" /><vm:FingerprintBitmapControl Width="200" Height="200" Bits="{Binding CandidateBits}" AutomationProperties.Name="候选图 8×8 指纹位图" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="XOR 位图" HorizontalAlignment="Center" /><vm:FingerprintBitmapControl Width="200" Height="200" Bits="{Binding XorBits}" AutomationProperties.Name="汉明距离 XOR 位图" /></StackPanel>
        </Grid>

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="8">
          <StackPanel Spacing="6">
            <TextBlock Text="受控稳定性试验" FontSize="17" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ComboBox Width="120" ItemsSource="{Binding StabilityKinds}" SelectedItem="{Binding SelectedStabilityKind}" />
              <TextBox Width="300" Text="{Binding StabilityValuesText}" PlaceholderText="逗号分隔，最多 21 点" />
              <Button Command="{Binding RunStabilityCommand}" Content="运行试验" IsEnabled="{Binding HasSession}" />
            </StackPanel>
            <TextBlock Text="{Binding StabilitySummary}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
              <vm:FingerprintStabilityControl Height="180" Points="{Binding StabilityPoints}" AlgorithmId="{Binding SelectedAlgorithm.AlgorithmId}" AutomationProperties.Name="当前算法汉明距离稳定性曲线" />
              <Image Grid.Column="1" Height="180" Stretch="Uniform" Source="{Binding StabilityPreview}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" Padding="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <ProgressBar Grid.Column="1" Width="140" IsIndeterminate="True" IsVisible="{Binding IsOperationBusy}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
