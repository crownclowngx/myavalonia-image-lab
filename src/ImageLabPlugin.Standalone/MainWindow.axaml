<Window
    x:Class="ImageLabPlugin.Standalone.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1280"
    Height="820"
    Title="ImageLabPlugin Standalone">
  <TabControl>
    <TabItem Header="水印写入">
      <ContentControl x:Name="EmbedPreview" />
    </TabItem>
    <TabItem Header="提取与验证">
      <ContentControl x:Name="InspectPreview" />
    </TabItem>
    <TabItem Header="频域分析器">
      <ContentControl x:Name="SpectrumPreview" />
    </TabItem>
    <TabItem Header="图像比较实验室">
      <ContentControl x:Name="ComparePreview" />
    </TabItem>
    <TabItem Header="鲁棒性实验室">
      <ContentControl x:Name="RobustnessPreview" />
    </TabItem>
    <TabItem Header="感知指纹">
      <ContentControl x:Name="FingerprintPreview" />
    </TabItem>
    <TabItem Header="位平面观察器">
      <ContentControl x:Name="BitPlanePreview" />
    </TabItem>
    <TabItem Header="LSB 隐写与统计实验">
      <ContentControl x:Name="LsbPreview" />
    </TabItem>
    <TabItem Header="卷积核实验台">
      <ContentControl x:Name="ConvolutionPreview" />
    </TabItem>
    <TabItem Header="小波实验室">
      <ContentControl x:Name="WaveletPreview" />
    </TabItem>
    <TabItem Header="频域滤波">
      <ContentControl x:Name="FrequencyFilterPreview" />
    </TabItem>
    <TabItem Header="频谱遮罩编辑器">
      <ContentControl x:Name="FrequencyMaskPreview" />
    </TabItem>
    <TabItem Header="周期噪声与陷波器">
      <ContentControl x:Name="PeriodicNoisePreview" />
    </TabItem>
    <TabItem Header="奇异值分解重建">
      <ContentControl x:Name="SvdPreview" />
    </TabItem>
    <TabItem Header="调色板与颜色迁移">
      <ContentControl x:Name="PaletteColorTransferPreview" />
    </TabItem>
    <TabItem Header="内容感知缩放">
      <ContentControl x:Name="SeamCarvingPreview" />
    </TabItem>
    <TabItem Header="梯度域融合">
      <ContentControl x:Name="PoissonBlendingPreview" />
    </TabItem>
    <TabItem Header="频谱艺术">
      <ContentControl x:Name="SpectralArtPreview" />
    </TabItem>
    <TabItem Header="混合图像">
      <ContentControl x:Name="HybridImagePreview" />
    </TabItem>
    <TabItem Header="幅度与相位交换">
      <ContentControl x:Name="MagnitudePhasePreview" />
    </TabItem>
    <TabItem Header="图像示波器">
      <ContentControl x:Name="ImageOscilloscopePreview" />
    </TabItem>
  </TabControl>
</Window>
