<Window
    x:Class="ImageLabPlugin.Standalone.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1280"
    Height="820"
    Title="ImageLabPlugin Standalone">
  <TabControl>
    <TabItem Header="水印写入">
      <ContentControl x:Name="EmbedPreview" />
    </TabItem>
    <TabItem Header="提取与验证">
      <ContentControl x:Name="InspectPreview" />
    </TabItem>
    <TabItem Header="频域分析器">
      <ContentControl x:Name="SpectrumPreview" />
    </TabItem>
    <TabItem Header="图像比较实验室">
      <ContentControl x:Name="ComparePreview" />
    </TabItem>
    <TabItem Header="鲁棒性实验室">
      <ContentControl x:Name="RobustnessPreview" />
    </TabItem>
    <TabItem Header="感知指纹">
      <ContentControl x:Name="FingerprintPreview" />
    </TabItem>
  </TabControl>
</Window>
